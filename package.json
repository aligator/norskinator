{
  "name": "norskinator",
  "version": "1.0.0",
  "private": true,
  "description": "Static web app for drilling Norwegian (bokmål) grammar with spaced repetition.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:data": "tsx scripts/fetch-data.ts",
    "build:prepositions": "tsx scripts/build-prepositions.ts",
    "build:adjectives": "tsx scripts/build-adjectives.ts",
    "data": "pnpm run fetch:data && pnpm run build:prepositions && pnpm run build:adjectives",
    "review:export": "tsx scripts/review/export.ts",
    "review:merge": "tsx scripts/review/merge.ts",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unbzip2-stream": "^1.4.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "lit": "^3.3.3",
    "workbox-window": "^7.4.1"
  }
}
